{
  "schemaVersion": 1,
  "id": "vanilla-finest-helper",
  "version": "${version}",
  "name": "Vanilla Finest Helper",
  "description": "The players' side of the Vanilla Finest modpacks: the setup screen (languages, controls, graphics, folders, look; 26.3 for now), an automatic GUI scale, where Flashback saves replays and Axiom keeps blueprints, and the shared-folder option. Fixes for the packs' mods are in Vanilla Finest Fixes.",
  "authors": ["Hiveko"],
  "contact": {
    "sources": "https://github.com/Hiveko75/vanilla-finest-helper",
    "issues": "https://github.com/Hiveko75/vanilla-finest-helper/issues"
  },
  "license": "ARR",
  "icon": "assets/vanilla-finest-helper/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.hiveko.vanillafinest.helper.VanillaFinestHelper"${client_extra}],
    "preLaunch": ["io.github.hiveko.vanillafinest.helper.homefolders.HomeFolders"]${entrypoints_extra}
  },
  "mixins": [
    {
      "config": "vanilla-finest-helper.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_min}",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}"
  },
  "recommends": {
    "fabric-api": "*"
  },
  "suggests": {
    "keycaps": "*"
  }
}
